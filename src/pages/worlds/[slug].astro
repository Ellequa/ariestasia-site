---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { imageDimensions } from '../../utils/imageDimensions';
import { collections, collectionList } from "../../data/collections.js";

import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  return collectionList.map((collection) => ({
    params: {
      slug: collection.slug,
    },
  }));
}

const { slug } = Astro.params;
const collection = collections[slug];

if (!collection) {
  return Astro.redirect("/");
}

const collectionDirectory = path.join(
  process.cwd(),
  "public",
  "images",
  "collections",
  collection.slug
);

let availableFiles = [];

if (fs.existsSync(collectionDirectory)) {
  availableFiles = fs
    .readdirSync(collectionDirectory)
    .filter((file) => /\.(jpg|jpeg|png|webp|avif)$/i.test(file));
}

function makeAlt(pieceName, file) {
  const description = file
    .replace(/\.[^.]+$/, "")
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());

  return `${pieceName}, ${description}`;
}

const pieces = (collection.pieces ?? [])
  .map((piece) => {
    const images = (piece.images ?? [])
      .filter((image) => availableFiles.includes(image.file))
      .map((image) => ({
        ...image,
        src: `/images/collections/${collection.slug}/${image.file}`,
        alt: makeAlt(piece.name, image.file),
      }));

    return {
      ...piece,
      images,
    };
  })
  .filter((piece) => piece.images.length > 0);
const dimensions = Object.fromEntries(await Promise.all(pieces.flatMap(piece => piece.images).map(async image => [image.src, await imageDimensions(image.src)])));
---

<BaseLayout
  title={`${collection.name} | Ariestasia`}
  description={collection.description}
>
  <main class="collection-page">
    <section class="collection-hero">
      <div class="collection-heading">
        <a class="top-home-link" href="/">
          Home
        </a>

        <p class="eyebrow">{collection.eyebrow}</p>

        <h1>{collection.name}</h1>

        <p class="description">
          {collection.description}
        </p>
      </div>

      <div class="collection-intro">
        <p>{collection.introduction}</p>
      </div>
    </section>

    {
      pieces.length > 0 ? (
        <section class="pieces">
          {pieces.map((piece, pieceIndex) => (
            <article class="piece">
              <header class="piece-heading">
                <p class="piece-number">
                  {String(pieceIndex + 1).padStart(2, "0")}
                </p>

                <h2>{piece.name}</h2>
              </header>

              <div class="piece-gallery">
                {piece.images.map((image, imageIndex) => (
                  <figure
                    class:list={[
                      "piece-image",
                      image.role === "hero" && "piece-image--hero",
                      image.role === "side" && "piece-image--side",
                      image.role === "detail" && "piece-image--detail",
                    ]}
                  >
                    <div
                      class="image-frame"
                      style={`aspect-ratio: ${image.aspect ?? "4 / 5"};`}
                    >
                      <img
                        src={image.src}
                        width={dimensions[image.src].width}
                        height={dimensions[image.src].height}
                        alt={image.alt}
                        loading={
                          pieceIndex === 0 && imageIndex === 0
                            ? "eager"
                            : "lazy"
                        }
                        decoding="async"
                        style={`
                          object-position: ${image.position ?? "center center"};
                          object-fit: ${image.fit ?? "cover"};
                        `}
                      />
                    </div>
                  </figure>
                ))}
              </div>
            </article>
          ))}
        </section>
      ) : (
        <section class="empty-collection">
          <p>This world is being prepared.</p>
        </section>
      )
    }

    <nav class="world-navigation" aria-label="Ariestasia navigation">
      <a class="home-link" href="/">
        Home
      </a>

      <span class="nav-divider" aria-hidden="true">•</span>

      {collectionList.map((world) => (
        <a
          href={`/worlds/${world.slug}/`}
          aria-current={world.slug === collection.slug ? "page" : undefined}
        >
          {world.name}
        </a>
      ))}
    </nav>
  </main>
</BaseLayout>

<style>
  .collection-page {
    min-height: 100vh;
    background: #080807;
    color: #eee8df;
  }

  .collection-hero {
    width: min(100% - 8rem, 1440px);
    margin: 0 auto;
    padding: clamp(6rem, 9vw, 9rem) 0 clamp(6rem, 9vw, 9rem);

    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.8fr);
    gap: clamp(4rem, 9vw, 9rem);
    align-items: end;
  }

  .top-home-link {
    display: inline-block;
    margin-bottom: 3.5rem;

    color: #c8b79f;

    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.17em;
    text-decoration: none;
    text-transform: uppercase;

    border-bottom: 1px solid rgba(200, 183, 159, 0.28);
    padding-bottom: 0.3rem;

    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .top-home-link:hover,
  .top-home-link:focus-visible {
    color: #eee8df;
    border-color: rgba(238, 232, 223, 0.8);
  }

  .top-home-link:focus-visible {
    outline: 1px solid rgba(238, 232, 223, 0.65);
    outline-offset: 6px;
  }

  .eyebrow,
  .piece-number {
    margin: 0 0 1.25rem;

    color: #b8a68f;

    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;

    color: #eee8df;

    font-family: var(--font-display, Georgia, serif);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(5rem, 10vw, 10rem);
    line-height: 0.88;
  }

  h2 {
    font-size: clamp(3.3rem, 6vw, 6rem);
    line-height: 0.95;
  }

  .description {
    max-width: 36rem;
    margin: 2rem 0 0;

    color: #b9afa3;

    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    line-height: 1.6;
  }

  .collection-intro {
    max-width: 31rem;

    color: #a99f94;

    font-size: 1rem;
    line-height: 1.8;
  }

  .collection-intro p {
    margin: 0;
  }

  .pieces {
    padding-bottom: clamp(8rem, 14vw, 14rem);
  }

  .piece {
    width: min(100% - 5rem, 1500px);
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 9rem) 0;

    border-top: 1px solid rgba(238, 232, 223, 0.12);
  }

  .piece:first-child {
    border-top: none;
    padding-top: 0;
  }

  .piece-heading {
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  .piece-gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 1.8vw, 1.8rem);
    align-items: start;
  }

  .piece-image {
    margin: 0;
  }

  .piece-image--hero {
    grid-column: span 8;
  }

  .piece-image--side {
    grid-column: span 4;
  }

  .piece-image--detail {
    grid-column: span 4;
  }

  .image-frame {
    width: 100%;
    overflow: hidden;
    background: #0b0b0a;
  }

  .image-frame img {
    display: block;

    width: 100%;
    height: 100%;

    transition: transform 650ms ease;
  }

  .piece-image:hover img {
    transform: scale(1.01);
  }

  .empty-collection {
    width: min(100% - 4rem, 1440px);
    margin: 0 auto;
    padding: 4rem 0 10rem;

    color: #91877d;
  }

  .world-navigation {
    width: min(100% - 4rem, 1440px);
    margin: 0 auto;
    padding: 2rem 0 4rem;

    border-top: 1px solid rgba(238, 232, 223, 0.14);

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .world-navigation a {
    color: #8f867d;

    text-decoration: none;

    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;

    transition: color 180ms ease;
  }

  .world-navigation a:hover,
  .world-navigation a:focus-visible,
  .world-navigation a[aria-current="page"] {
    color: #eee8df;
  }

  .home-link {
    color: #c8b79f !important;
  }

  .home-link:hover,
  .home-link:focus-visible {
    color: #eee8df !important;
  }

  .nav-divider {
    color: rgba(238, 232, 223, 0.25);
    font-size: 0.7rem;
  }

  @media (max-width: 900px) {
    .collection-hero {
      width: min(100% - 3rem, 1440px);
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 5rem;
    }

    .piece {
      width: min(100% - 2rem, 1500px);
    }

    .piece-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .piece-image--hero {
      grid-column: 1 / -1;
    }

    .piece-image--side,
    .piece-image--detail {
      grid-column: auto;
    }
  }

  @media (max-width: 560px) {
    .collection-hero {
      width: calc(100% - 2.4rem);
      padding: 3rem 0 4rem;
      gap: 2rem;
    }

    .top-home-link {
      margin-bottom: 2.6rem;
    }

    h1 {
      font-size: clamp(4rem, 21vw, 6rem);
    }

    h2 {
      font-size: clamp(3rem, 15vw, 4.5rem);
    }

    .description {
      font-size: 1.05rem;
    }

    .piece {
      width: 100%;
      padding: 5rem 0;
    }

    .piece-heading {
      width: calc(100% - 2.4rem);
      margin-left: auto;
      margin-right: auto;
    }

    .piece-gallery {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .piece-image--hero,
    .piece-image--side,
    .piece-image--detail {
      grid-column: 1;
    }

    .image-frame {
      aspect-ratio: auto !important;
    }

    .image-frame img {
      width: 100%;
      height: auto;

      object-fit: contain !important;
      object-position: center !important;
    }

    .world-navigation {
      width: calc(100% - 2.4rem);
      gap: 1rem 1.4rem;
    }

    .nav-divider {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-frame img {
      transition: none;
    }

    .piece-image:hover img {
      transform: none;
    }

    .top-home-link {
      transition: none;
    }
  }
</style>
