---
import BaseLayout from "../layouts/BaseLayout.astro";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import WorldSection from "../components/WorldSection.astro";
import CraftSection from "../components/CraftSection.astro";
import FeaturedGrid from "../components/FeaturedGrid.astro";
import Adornments from "../components/Adornments.astro";
import CommissionSection from "../components/CommissionSection.astro";
import MakerSection from "../components/MakerSection.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />

  <main>
    <Hero />

    <Intro />

    <div id="worlds">
      <WorldSection
        name="Deep Sea"
        href="/worlds/deep-sea/"
        description="Dark forms, mineral blues and the strange beauty of things found below."
        image="/images/worlds/deep-sea.jpg"
      />

      <WorldSection
        name="Pearl"
        href="/worlds/pearl/"
        description="Shell, ivory and iridescence shaped into ceremonial forms."
        image="/images/worlds/pearl.jpg"
        side="right"
      />

      <WorldSection
        name="Reef"
        href="/worlds/reef/"
        description="Colour, movement and marine forms drawn from the shallows."
        image="/images/worlds/reef.jpg"
      />

      <WorldSection
        name="Garden"
        href="/worlds/garden/"
        description="Botanical forms, vivid colour and adornment in full bloom."
        image="/images/worlds/garden.jpg"
        side="right"
      />

      <WorldSection
        name="Ember"
        href="/worlds/ember/"
        description="Crimson, copper and gold with a darker ceremonial edge."
        image="/images/worlds/ember.jpg"
      />
    </div>

    <CraftSection />

    <FeaturedGrid />

    <Adornments />

    <CommissionSection />

    <MakerSection />
  </main>

  <Footer />
</BaseLayout>