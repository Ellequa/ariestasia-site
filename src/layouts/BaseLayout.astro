---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Ariestasia | Handmade Crowns & Adornments",
  description = "One-of-a-kind crowns and adornments handmade in Bali. Wearable sculpture shaped by sea, myth and imagination.",
  noindex = false,
} = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL('/images/hero/golden-orange-crown.jpg', Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo/ariestasia-logo-white.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || !Astro.site) && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ariestasia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:alt" content="Ariestasia rose-gold crown with shell details, pearls and crystal drops" />
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content="Ariestasia rose-gold crown with shell details, pearls and crystal drops" />
    </>}

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />
  </head>

  <body>
    <slot />
  </body>
</html>
