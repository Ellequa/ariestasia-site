---
import "../styles/global.css";
import { imageDimensions } from '../utils/imageDimensions';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Ariestasia | Handmade Crowns & Adornments",
  description = "One-of-a-kind crowns and adornments handmade in Bali. Wearable sculpture shaped by sea, myth and imagination.",
  noindex = false,
} = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImagePath = '/images/hero/golden-orange-crown.jpg';
const socialImage = Astro.site ? new URL(socialImagePath, Astro.site) : undefined;
const socialImageDimensions = await imageDimensions(socialImagePath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || !Astro.site) && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ariestasia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:width" content={socialImageDimensions.width} />
      <meta property="og:image:height" content={socialImageDimensions.height} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:alt" content="Ariestasia rose-gold crown with shell details, pearls and crystal drops" />
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content="Ariestasia rose-gold crown with shell details, pearls and crystal drops" />
    </>}

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />
  </head>

  <body>
    <slot />
  </body>
</html>
